# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/

# --- Виртуальные окружения ----------------------------------------------
.venv/
venv/
env/
ENV/

# --- IDE ------------------------------------------------------------------
.vscode/
.idea/
*.iml

# --- Переменные окружения / секреты ---------------------------------------
.env
.env.local
.env.production
.env.test

