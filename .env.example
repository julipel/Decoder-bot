# Переменные окружения MVP «Декодер».
# Секреты не имеют значений по умолчанию в коде (src/dekoder/shared/config.py)
# и не хранятся нигде, кроме окружения. Скопируйте этот файл в `.env` или
# `.env.local` и заполните значения — оба имени поддерживаются конфигурацией.

# --- Application (ApplicationSettings, префикс APP_) ------------------------
APP_NAME=dekoder
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Telegram (TelegramSettings, префикс TELEGRAM_) — секреты, обязательны --
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- LLM (LLMSettings, префикс LLM_) — общие параметры вызова модели --------
LLM_TIMEOUT=30.0
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# --- OpenRouter (OpenRouterSettings, префикс OPENROUTER_) -------------------
# api_key — секрет, обязателен; остальное — значения по умолчанию, не секреты.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# --- Database (DatabaseSettings, префикс DATABASE_) — Sprint 2, S2-01 -------
# Async SQLAlchemy + aiosqlite; путь ниже — относительный, каталог для
# файла создаётся автоматически при старте приложения (только каталог, не
# таблицы — схема БД создаётся исключительно через Alembic).
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Prompt Engine (PromptSettings, префикс PROMPT_) — Sprint 4, S4-06 ------
# Бюджет TokenBudgetPolicy.enforce() — эвристика по символам, не реальные
# токены модели (ADR-4.4); подобран консервативно относительно типичного
# контекстного окна используемых моделей.
PROMPT_TOKEN_BUDGET=12000
