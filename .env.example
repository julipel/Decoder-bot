# Переменные окружения MVP «Декодер».
# Ни один секрет не хранится в SQLite или в коде (docs/01, §4.7; docs/02, §13).

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- LLM Adapter (генеративная модель) — docs/01, §4.2; docs/02, §16.2 -----
# Конфигурируется НЕЗАВИСИМО от Embedding Adapter.
LLM_PROVIDER=yandex
LLM_MODEL=
YANDEXGPT_API_KEY=
OPENAI_API_KEY=

# --- Embedding Adapter (RAG/Search) — docs/02, §16.2 ------------------------
# Смена LLM_PROVIDER не требует переиндексации; переиндексация нужна только
# при смене EMBEDDING_PROVIDER/EMBEDDING_MODEL, версии модели или размерности.
EMBEDDING_PROVIDER=yandex
EMBEDDING_MODEL=

# --- Хранилища ---------------------------------------------------------------
SQLITE_PATH=./data/dekoder.sqlite3
QDRANT_URL=http://localhost:6333
DOCUMENTS_STORAGE_PATH=./data/documents

# --- Профиль автора (docs/01, §2.3) — единый профиль, seed при пустой БД ----
PROFILE_SEED_PATH=./config/profile.seed.json

# --- Память (docs/02, §16.3, §16.5) ------------------------------------------
DIALOGUE_HISTORY_WINDOW_SIZE=20
FACT_DRAFT_TTL_SECONDS=300

# --- Панель администратора (docs/01, §4.7; docs/02, §13) --------------------
# Единственная учётная запись; хеш пароля НЕ хранится в SQLite.
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
