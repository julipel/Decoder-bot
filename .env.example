# Переменные окружения MVP «Декодер» (версия 2.0 — docs/versions/06_development_environment_v2.0.md).
# Ни один секрет не хранится в структурированном хранилище или в коде.

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Model Gateway (генеративные модели) — docs/versions/02_v2.0, §8 --------
# Конфигурируется НЕЗАВИСИМО от Embedding-клиента, используемого RAG Service.
LLM_PROVIDER=yandex
LLM_MODEL=
YANDEXGPT_API_KEY=
OPENAI_API_KEY=

# --- Embedding-клиент (деталь infrastructure/vector_storage) ----------------
# Смена LLM_PROVIDER не требует переиндексации; переиндексация нужна только
# при смене EMBEDDING_PROVIDER/EMBEDDING_MODEL, версии модели или размерности.
EMBEDDING_PROVIDER=yandex
EMBEDDING_MODEL=

# --- Хранилища ---------------------------------------------------------------
STRUCTURED_STORAGE_PATH=./data/dekoder.sqlite3
VECTOR_STORAGE_URL=http://localhost:6333
DOCUMENTS_STORAGE_PATH=./data/documents
AUDIT_LOG_PATH=./data/audit.log.jsonl

# --- Author Profile Service (docs/versions/04_v2.0, §8) ---------------------
# Лимит активных (неархивных) профилей на пользователя; архивные в лимит не входят.
PROFILE_ACTIVE_LIMIT=4
# Seed-профиль по умолчанию — используется только при первом запуске на пустом хранилище.
PROFILE_SEED_PATH=./config/profile.seed.json

# --- Каталоги (seed-файлы, не секреты) --------------------------------------
MODEL_CATALOG_SEED_PATH=./config/model_catalog.seed.json
CONTENT_SKILL_SEED_PATH=./config/content_skills.seed.json

# --- Память (Memory Service) -------------------------------------------------
DIALOGUE_HISTORY_WINDOW_SIZE=20
FACT_DRAFT_TTL_SECONDS=300

# --- Панель администратора --------------------------------------------------
# Единственная учётная запись; хеш пароля НЕ хранится в структурированном хранилище.
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- Логирование -------------------------------------------------------------
LOG_LEVEL=INFO
