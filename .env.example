# Переменные окружения MVP «Декодер».
# Секреты не имеют значений по умолчанию в коде (src/dekoder/shared/config.py)
# и не хранятся нигде, кроме окружения. Скопируйте этот файл в `.env` или
# `.env.local` и заполните значения — оба имени поддерживаются конфигурацией.

# --- Application (ApplicationSettings, префикс APP_) ------------------------
APP_NAME=dekoder
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
# DEBUG/INFO/WARNING/ERROR (Sprint 11, S11-04, ADR-11.5) — гранулярный
# уровень логирования, применяется ТОЛЬКО когда APP_DEBUG=false: APP_DEBUG=true
# продолжает безусловно форсировать DEBUG независимо от этого значения
# (обратная совместимость).
APP_LOG_LEVEL=INFO

# --- Telegram (TelegramSettings, префикс TELEGRAM_) — секреты, обязательны --
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Опционально: SOCKS5/HTTP-прокси для api.telegram.org — нужен только если
# сеть сервера не имеет прямого доступа к Telegram (например, DPI на пути
# egress-трафика; SSH-туннель через сервер в другой сети даёт socks5://,
# см. README «Диагностика типовых ошибок»). Не задавать, если Telegram
# доступен напрямую — большинство развёртываний.
TELEGRAM_PROXY_URL=

# --- LLM (LLMSettings, префикс LLM_) — общие параметры вызова модели --------
LLM_TIMEOUT=30.0
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# --- LLM Provider (LLMProviderSettings, префикс LLM_PROVIDER_) --------------
# Sprint 11, S11-01, ADR-11.1: дженерик OpenAI-Chat-Completions-совместимый
# провайдер — не зафиксирован на конкретном вендоре, настраивается только
# через переменные ниже. api_key/base_url/default_model — ОБЯЗАТЕЛЬНЫ, без
# значений по умолчанию (у дженерик-провайдера нет корректного универсального
# значения — Settings() упадёт при старте, если что-то из них не задано,
# намеренно, вместо тихого фолбэка на прежний OpenRouter URL).
#
# base_url — корневой URL Chat Completions API выбранного вами агрегатора
# (например, https://openrouter.ai/api/v1 или другой OpenAI-совместимый
# сервис). default_model — id модели в конвенции ИМЕННО этого агрегатора.
#
# ВАЖНО (ADR-11.2): id моделей в infrastructure/model_catalog/catalog.json
# — иллюстративный дефолт в конвенции OpenRouter (`vendor/model-name`), не
# проверяется кодом (ModelId format-agnostic). При смене base_url на другой
# реальный агрегатор отредактируйте id моделей в catalog.json вручную под
# то, что реально поддерживает выбранный сервис — иначе первый же запрос с
# несовместимым id завершится LLM_PROVIDER_CLIENT_ERROR/
# LLM_PROVIDER_MALFORMED_RESPONSE, не раньше.
LLM_PROVIDER_API_KEY=
# LLM_PROVIDER_BASE_URL=            # обязательно, без примера — впишите URL вашего агрегатора
# LLM_PROVIDER_DEFAULT_MODEL=       # обязательно, id модели в конвенции вашего агрегатора
LLM_PROVIDER_PROVIDER_ID=custom

# --- Database (DatabaseSettings, префикс DATABASE_) — Sprint 2, S2-01 -------
# Async SQLAlchemy + aiosqlite; путь ниже — относительный, каталог для
# файла создаётся автоматически при старте приложения (только каталог, не
# таблицы — схема БД создаётся исключительно через Alembic).
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Prompt Engine (PromptSettings, префикс PROMPT_) — Sprint 4, S4-06 ------
# Бюджет TokenBudgetPolicy.enforce() — эвристика по символам, не реальные
# токены модели (ADR-4.4); подобран консервативно относительно типичного
# контекстного окна используемых моделей.
PROMPT_TOKEN_BUDGET=12000

# --- Memory (MemorySettings, префикс MEMORY_) — Sprint 5, S5-06, ADR-5.6 ----
# limit MemoryRepository.find_relevant() — количество подтверждённых
# записей памяти, попадающих в секцию 4 промпта; объём текста ограничивает
# отдельно TokenBudgetPolicy (не эта настройка).
MEMORY_MAX_RELEVANT_RECORDS=5

# --- Провайдер эмбеддингов (EmbeddingProviderSettings, префикс EMBEDDING_PROVIDER_) ---
# Sprint 6, ADR-6.3 → параметризовано в Sprint 12, ADR-12.1. Не зависит от
# LLM_PROVIDER_* — выбранный LLM-агрегатор не гарантированно отдаёт
# embeddings API, эмбеддинги настраиваются отдельно. Дефолт base_url —
# прямой OpenAI (обратная совместимость); для агрегатора (например RouterAI)
# переопределить оба значения.
EMBEDDING_PROVIDER_API_KEY=
EMBEDDING_PROVIDER_BASE_URL=https://api.openai.com/v1
EMBEDDING_PROVIDER_EMBEDDING_MODEL=text-embedding-3-small

# --- Qdrant (QdrantSettings, префикс QDRANT_) — Sprint 6, S6-02 -------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=dekoder_knowledge
# Размерность вектора text-embedding-3-small — должна совпадать с
# EMBEDDING_PROVIDER_EMBEDDING_MODEL выше.
QDRANT_VECTOR_SIZE=1536

# --- Knowledge (KnowledgeSettings, префикс KNOWLEDGE_) — Sprint 6, S6-02 ----
KNOWLEDGE_MAX_FILE_SIZE_BYTES=20000000
KNOWLEDGE_CHUNK_SIZE=1500
KNOWLEDGE_CHUNK_OVERLAP=200
KNOWLEDGE_SEARCH_LIMIT=5
KNOWLEDGE_MIN_RELEVANCE_SCORE=0.35
KNOWLEDGE_STORAGE_PATH=./data/knowledge_documents

# --- Model catalog (ModelCatalogSettings, префикс MODEL_CATALOG_) -----------
# Sprint 7, S7-03, ADR-7.4. Путь к статичному JSON-каталогу AI-моделей —
# по умолчанию сид-файл внутри пакета (infrastructure/model_catalog/
# catalog.json), переопределять нужно только для нестандартного каталога
# (например, изолированный fixture-файл в тестах). Оставьте пустым/не
# задавайте переменную, чтобы использовать сид-каталог по умолчанию.
# MODEL_CATALOG_CATALOG_PATH=

# --- Admin (AdminSettings, префикс ADMIN_) — Sprint 8, S8-02, ADR-8.3 -------
# api_key — секрет, обязателен. Статичный ключ, который клиент передаёт в
# заголовке X-Admin-Api-Key на все /admin/* эндпоинты (не login/session/JWT
# — единственная admin-учётка для MVP, скоуп-решение №1).
ADMIN_API_KEY=
# Таймаут одного probe GET /admin/health (секунды) — отдельно от LLM_TIMEOUT,
# заметно короче: это проверка доступности, не генерация.
ADMIN_HEALTH_CHECK_TIMEOUT=3.0

# --- Deployment (production only) — Sprint 11, S11-04, ADR-11.5 -------------
# Используются только docker-compose.prod.yml (Caddy-оверлей) и
# deploy/backup.sh (S11-05) — не читаются напрямую shared/config.py, не
# входят ни в одну BaseSettings-группу приложения.
#
# DOMAIN — публичное доменное имя, указывающее на IP сервера (для Caddy,
# автоматический HTTPS через Let's Encrypt). Для локальной проверки без
# реального домена — DOMAIN=localhost: Caddy тогда выпускает локально
# доверенный сертификат через свой внутренний CA вместо Let's Encrypt (см.
# deploy/Caddyfile).
DOMAIN=localhost

# RETENTION_DAYS — зарезервировано для deploy/backup.sh (S11-05, вне скоупа
# этой задачи): опционально, количество дней хранения бэкапов перед
# автоудалением. Без значения — бэкапы не удаляются автоматически (безопасный
# дефолт).
# RETENTION_DAYS=
