# Переменные окружения MVP «Декодер».
# Секреты не имеют значений по умолчанию в коде (src/dekoder/shared/config.py)
# и не хранятся нигде, кроме окружения. Скопируйте этот файл в `.env` или
# `.env.local` и заполните значения — оба имени поддерживаются конфигурацией.

# --- Application (ApplicationSettings, префикс APP_) ------------------------
APP_NAME=dekoder
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Telegram (TelegramSettings, префикс TELEGRAM_) — секреты, обязательны --
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- LLM (LLMSettings, префикс LLM_) — общие параметры вызова модели --------
LLM_TIMEOUT=30.0
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# --- OpenRouter (OpenRouterSettings, префикс OPENROUTER_) -------------------
# api_key — секрет, обязателен; остальное — значения по умолчанию, не секреты.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# --- Database (DatabaseSettings, префикс DATABASE_) — Sprint 2, S2-01 -------
# Async SQLAlchemy + aiosqlite; путь ниже — относительный, каталог для
# файла создаётся автоматически при старте приложения (только каталог, не
# таблицы — схема БД создаётся исключительно через Alembic).
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Prompt Engine (PromptSettings, префикс PROMPT_) — Sprint 4, S4-06 ------
# Бюджет TokenBudgetPolicy.enforce() — эвристика по символам, не реальные
# токены модели (ADR-4.4); подобран консервативно относительно типичного
# контекстного окна используемых моделей.
PROMPT_TOKEN_BUDGET=12000

# --- Memory (MemorySettings, префикс MEMORY_) — Sprint 5, S5-06, ADR-5.6 ----
# limit MemoryRepository.find_relevant() — количество подтверждённых
# записей памяти, попадающих в секцию 4 промпта; объём текста ограничивает
# отдельно TokenBudgetPolicy (не эта настройка).
MEMORY_MAX_RELEVANT_RECORDS=5

# --- OpenAI (OpenAiSettings, префикс OPENAI_) — Sprint 6, S6-02, ADR-6.3 ----
# api_key — секрет, обязателен. Провайдер эмбеддингов RAG, не зависит от
# OPENROUTER_* (OpenRouter не отдаёт embeddings API).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Qdrant (QdrantSettings, префикс QDRANT_) — Sprint 6, S6-02 -------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=dekoder_knowledge
# Размерность вектора text-embedding-3-small — должна совпадать с
# OPENAI_EMBEDDING_MODEL выше.
QDRANT_VECTOR_SIZE=1536

# --- Knowledge (KnowledgeSettings, префикс KNOWLEDGE_) — Sprint 6, S6-02 ----
KNOWLEDGE_MAX_FILE_SIZE_BYTES=20000000
KNOWLEDGE_CHUNK_SIZE=1500
KNOWLEDGE_CHUNK_OVERLAP=200
KNOWLEDGE_SEARCH_LIMIT=5
KNOWLEDGE_MIN_RELEVANCE_SCORE=0.5
KNOWLEDGE_STORAGE_PATH=./data/knowledge_documents

# --- Model catalog (ModelCatalogSettings, префикс MODEL_CATALOG_) -----------
# Sprint 7, S7-03, ADR-7.4. Путь к статичному JSON-каталогу AI-моделей —
# по умолчанию сид-файл внутри пакета (infrastructure/model_catalog/
# catalog.json), переопределять нужно только для нестандартного каталога
# (например, изолированный fixture-файл в тестах). Оставьте пустым/не
# задавайте переменную, чтобы использовать сид-каталог по умолчанию.
# MODEL_CATALOG_CATALOG_PATH=

# --- Admin (AdminSettings, префикс ADMIN_) — Sprint 8, S8-02, ADR-8.3 -------
# api_key — секрет, обязателен. Статичный ключ, который клиент передаёт в
# заголовке X-Admin-Api-Key на все /admin/* эндпоинты (не login/session/JWT
# — единственная admin-учётка для MVP, скоуп-решение №1).
ADMIN_API_KEY=
# Таймаут одного probe GET /admin/health (секунды) — отдельно от LLM_TIMEOUT,
# заметно короче: это проверка доступности, не генерация.
ADMIN_HEALTH_CHECK_TIMEOUT=3.0
