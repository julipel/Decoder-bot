{$DOMAIN} {
	reverse_proxy api:8000

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

# Для запуска без публичного домена (проверка на своём сервере по IP/
# внутреннем DNS) — Caddy при DOMAIN=localhost или любом non-public host
# автоматически выпускает локально доверенный сертификат вместо
# Let's Encrypt (внутренний CA), не требуя интернет-доступности сервера
# на 80/443 извне. Реальный прод — DOMAIN должен быть публичным именем,
# указывающим на IP сервера, с открытыми 80/443.
